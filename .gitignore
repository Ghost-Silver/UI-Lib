node_modules/
dist/
.turbo/
coverage/
playwright-report/
test-results/
*.tsbuildinfo
.DS_Store
.env
.env.local
.vite/

# tsup bundles each tsup.config.ts to a sibling temp file and leaves it behind
# after the build. Left unignored it breaks `pnpm lint` and gets committed.
tsup.config.bundled_*.mjs

# Real-device telemetry scratch (see apps/docs/vite.config.ts)
.diag/

# Real-device measurement output: one directory per GPU bucket. Kept out of
# the tree because the numbers describe one machine, not the project.
reports/

# pnpm leaves zero-byte `_tmp_<pid>_<hash>` markers at the workspace root when a
# recursive run is interrupted. They are not part of the project.
_tmp_*

# Gate and server output. `nohup node scripts/check-*.mjs > x.log` is how every
# round of this work has been inspected, and twice a stray one has been
# committed because it was written into the repo root rather than /tmp.
*.log

# Multi-agent teamwork artifacts
.agents/

