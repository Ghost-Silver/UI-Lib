{
	"name": "ui-lib",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "GPU-first visual effects layer for the web: 3D, particles, refraction, post-processing, scroll cinema.",
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"dev": "pnpm --filter @ui-lib/docs dev",
		"build": "pnpm -r --filter \"./packages/**\" run build",
		"typecheck": "pnpm -r run typecheck",
		"test": "pnpm build && vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:update": "playwright test --update-snapshots",
		"size": "node scripts/check-size.mjs",
		"measure": "node scripts/measure-device.mjs",
		"check:shaders": "node scripts/check-shaders.mjs",
		"check:shaders:self-test": "node scripts/check-shaders.mjs --self-test",
		"check:pixels": "node scripts/check-pixels.mjs",
		"check:components": "node scripts/check-components.mjs",
		"check:components:self-test": "node scripts/check-components.mjs --self-test",
		"check:post": "node scripts/check-post.mjs",
		"check:post:self-test": "node scripts/check-post.mjs --self-test",
		"check:pixels:self-test": "node scripts/check-pixels.mjs --self-test",
		"check:templates": "node scripts/check-templates.mjs",
		"check:templates:self-test": "node scripts/check-templates.mjs --self-test",
		"check:api": "node scripts/check-api.mjs",
		"check:api:self-test": "node scripts/check-api.mjs --self-test",
		"check:spec": "node scripts/check-spec.mjs",
		"check:spec:self-test": "node scripts/check-spec.mjs --self-test",
		"check:cascade": "node scripts/check-cascade.mjs",
		"check:cascade:self-test": "node scripts/check-cascade.mjs --self-test",
		"build:font-atlas": "node scripts/build-font-atlas.mjs",
		"verify": "pnpm lint && pnpm test && pnpm typecheck && pnpm size && pnpm check:api && pnpm check:templates && pnpm check:cascade",
		"verify:device": "pnpm verify && pnpm check:shaders",
		"lint": "biome check . && node scripts/check-templates.mjs && node scripts/check-api.mjs && node scripts/check-cascade.mjs",
		"format": "biome format --write .",
		"check:templates:write": "node scripts/check-templates.mjs --write"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.4",
		"@playwright/test": "^1.63.0",
		"@types/react": "^19.3.0",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	}
}
