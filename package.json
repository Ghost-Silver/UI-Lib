{
	"name": "ui-lib",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "GPU-first visual effects layer for the web: 3D, particles, refraction, post-processing, scroll cinema.",
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"dev": "pnpm --filter @ui-lib/docs dev",
		"build": "pnpm -r --filter \"./packages/**\" run build",
		"typecheck": "pnpm -r run typecheck",
		"test": "pnpm build && vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:update": "playwright test --update-snapshots",
		"size": "node scripts/check-size.mjs",
		"measure": "node scripts/measure-device.mjs",
		"check:shaders": "node scripts/check-shaders.mjs",
		"check:shaders:self-test": "node scripts/check-shaders.mjs --self-test",
		"verify": "pnpm test && pnpm typecheck && pnpm size",
		"verify:device": "pnpm verify && pnpm check:shaders",
		"lint": "biome check .",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.4",
		"@playwright/test": "^1.63.0",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	}
}
