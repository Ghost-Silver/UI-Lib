{
	"name": "@ui-lib/motion",
	"version": "0.0.1",
	"description": "Framework-agnostic motion for UI-Lib: scroll progress, beats and tracks on the shared frame clock.",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@ui-lib/core": "workspace:*"
	},
	"devDependencies": {
		"tsup": "^8.5.0",
		"typescript": "^5.9.3"
	}
}
