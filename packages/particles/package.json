{
	"name": "@ui-lib/particles",
	"version": "0.0.1",
	"description": "GPU particle engine for UI-Lib: compute-shader simulation, force fields and instanced sprite rendering.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Ghost-Silver/UI-Lib.git",
		"directory": "packages/particles"
	},
	"homepage": "https://github.com/Ghost-Silver/UI-Lib#readme",
	"bugs": {
		"url": "https://github.com/Ghost-Silver/UI-Lib/issues"
	},
	"keywords": [
		"ui",
		"ui-lib",
		"gpu",
		"particles",
		"compute",
		"webgpu",
		"webgl",
		"three"
	],
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"peerDependencies": {
		"three": ">=0.180.0"
	},
	"devDependencies": {
		"@types/three": "^0.186.0",
		"three": "0.186.1",
		"tsup": "^8.5.0",
		"typescript": "^5.9.3"
	}
}
