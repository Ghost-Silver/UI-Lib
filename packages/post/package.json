		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@ui-lib/core": "workspace:*"
	},
	"peerDependencies": {
		"three": ">=0.180.0"
	},
	"devDependencies": {
		"@types/three": "^0.186.0",
		"three": "0.186.1",
		"tsup": "^8.5.0",
		"typescript": "^5.9.3"
	}
}
