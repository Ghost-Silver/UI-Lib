{
	"name": "@ui-lib/core",
	"version": "0.0.1",
	"description": "Framework-agnostic runtime foundation for UI-Lib: device probing, adaptive quality, a single unified frame loop, math and lifecycle primitives.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Ghost-Silver/UI-Lib.git",
		"directory": "packages/core"
	},
	"homepage": "https://github.com/Ghost-Silver/UI-Lib#readme",
	"bugs": {
		"url": "https://github.com/Ghost-Silver/UI-Lib/issues"
	},
	"keywords": [
		"ui",
		"ui-lib",
		"gpu",
		"webgpu",
		"webgl",
		"scheduler",
		"quality",
		"three"
	],
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"devDependencies": {
		"tsup": "^8.5.0",
		"typescript": "^5.9.3"
	}
}
